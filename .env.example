# Seleciona o perfil do front no docker-compose.yml (lido pelo Docker Compose para
# escolher qual serviço sobe — o Compose lê SOMENTE este arquivo `.env`, nunca o
# `.env.production`, que é do Next e carregado quando NODE_ENV=production no build).
#   dev  -> serviço `web-dev`: `next dev` + bind-mount do código (HMR, sem rebuild).
#   prod -> serviço `web`: imagem standalone de produção (`next build` -> node server.js).
COMPOSE_PROFILES=dev

# URL da API acessada pelo NAVEGADOR (client-side).
# É embutida no bundle em tempo de build (variáveis NEXT_PUBLIC_* são estáticas).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# URL do storage (imagens/avatares) acessado pelo navegador.
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000

# URL da API acessada pelo SERVIDOR Next (prefetch SSR + middleware, dentro do container).
# Com a stack unificada (docker-compose `include`), API e front compartilham a mesma rede,
# então o front alcança a API pelo nome do serviço: `app` na porta interna 8000.
API_URL_SERVER=http://app:8000/api/v1
